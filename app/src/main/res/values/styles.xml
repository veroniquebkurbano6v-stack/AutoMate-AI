<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 文本样式 -->
    <style name="TextAppearance.PalmAgent.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="TextAppearance.PalmAgent.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.PalmAgent.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PalmAgent.Headline" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 按钮样式 -->
    <style name="Widget.PalmAgent.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <style name="Widget.PalmAgent.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="backgroundTint">@color/bg_input</item>
    </style>

    <style name="Widget.PalmAgent.Button.Danger" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="backgroundTint">@color/brand_danger</item>
    </style>
</resources>
