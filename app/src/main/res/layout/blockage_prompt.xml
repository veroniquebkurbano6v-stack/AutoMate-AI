<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/blockage_width"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/blockage_max_height"
    android:background="@drawable/bg_blockage_panel"
    android:elevation="12dp"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="#3B82F6"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvBlockageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI 操作受阻"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvBlockageSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ 警告"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_severity_badge" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333B82F6"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvBlockageReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="受阻原因将显示在这里"
            android:textColor="#334155"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请按以下步骤操作："
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llBlockageSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_steps_container"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBlockageDone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="✓ 已完成，继续执行"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_action_button"
            android:elevation="4dp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
